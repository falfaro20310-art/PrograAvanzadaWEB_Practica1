@model VitalApp_WEB.Models.PatientDetailModel
@{
    ViewData["Title"] = "Detalle del paciente";
    Layout = "_InternalLayout";

    var p = Model.Profile;
    var fullName = $"{p.Name} {p.FirstName} {p.LastName}".Trim();

    string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "-";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-0">@fullName</h4>
        <small class="text-muted">Vista de solo lectura</small>
    </div>
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ti ti-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="row g-4">

    <!-- Datos personales -->
    <div class="col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Datos personales</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Nombre</dt>
                    <dd class="col-7">@fullName</dd>

                    <dt class="col-5 text-muted">Cédula</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(p.IdCard) ? "-" : p.IdCard)</dd>

                    <dt class="col-5 text-muted">Correo</dt>
                    <dd class="col-7">@p.Email</dd>

                    <dt class="col-5 text-muted">Edad</dt>
                    <dd class="col-7">@(p.Age != null ? $"{p.Age} años" : "-")</dd>

                    <dt class="col-5 text-muted">Sexo</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(p.Gender) ? "-" : p.Gender)</dd>

                    <dt class="col-5 text-muted">Altura</dt>
                    <dd class="col-7">@(p.Height != null ? $"{Fmt(p.Height)} cm" : "-")</dd>

                    <dt class="col-5 text-muted">Peso</dt>
                    <dd class="col-7">@(p.Weight != null ? $"{Fmt(p.Weight)} kg" : "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Condiciones medicas -->
    <div class="col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Condiciones médicas</h5>
            </div>
            <div class="card-body">
                @if (p.MedicalConditions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Condición</th>
                                    <th>Descripción</th>
                                    <th>Diagnóstico</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in p.MedicalConditions)
                                {
                                    <tr>
                                        <td>@c.Name</td>
                                        <td>@c.Description</td>
                                        <td>@c.DiagnosticDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">El paciente no tiene condiciones médicas registradas.</p>
                }
            </div>
        </div>
    </div>

    <!-- Indicadores de salud -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Indicadores de salud</h5>
            </div>
            <div class="card-body">
                @if (Model.Indicators.Any())
                {
                    <div class="row row-cols-1 row-cols-md-3 g-3">
                        @foreach (var ind in Model.Indicators)
                        {
                            <div class="col">
                                <div class="card h-100 border">
                                    <div class="card-body d-flex flex-column gap-2">
                                        <span class="fw-semibold">@ind.Name</span>

                                        @if (ind.LastValue == null)
                                        {
                                            <span class="text-muted">Sin datos disponibles</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-4 fw-bold">
                                                    @Fmt(ind.LastValue) @ind.Unit
                                                    @if (ind.SecondaryValue != null)
                                                    {
                                                        <text>/ @Fmt(ind.SecondaryValue)</text>
                                                    }
                                                </span>
                                                @if (ind.IsAbnormal == true)
                                                {
                                                    <span class="badge bg-danger">Fuera de rango</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Normal</span>
                                                }
                                            </div>
                                            <small class="text-muted">
                                                Rango normal: @Fmt(ind.MinNormalValue) - @Fmt(ind.MaxNormalValue) @ind.Unit
                                            </small>
                                            <small class="text-muted">
                                                Último registro: @ind.LastMeasureDate?.ToString("dd MMM, yyyy")
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">El paciente no tiene indicadores registrados.</p>
                }
            </div>
        </div>
    </div>

</div>
