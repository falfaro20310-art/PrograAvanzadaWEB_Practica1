@model VitalApp_WEB.Models.UserModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_ExternalLayout";
}

<main class="d-flex flex-column justify-content-center min-vh-100 py-6">
    <section>
        <div class="container">
            <div class="row mb-6">
                <div class="col-xl-4 offset-xl-4 col-md-12 col-12">
                    <div class="text-center">
                        <div class="fs-2 fw-bold d-flex align-items-center gap-2 justify-content-center mb-6">
                            <img src="~/images/brand/logo-icon.svg" alt="VitalApp" />
                            <span>VitalApp</span>
                        </div>
                        <h1 class="mb-1">Recuperar Contraseña</h1>
                        <p class="mb-0 text-secondary">Te enviaremos una contraseña temporal a tu correo.</p>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-xl-5 col-lg-6 col-md-8 col-12">
                    <div class="card card-lg mb-6">
                        <div class="card-body p-6">

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-danger" role="alert">@ViewBag.Mensaje</div>
                            }

                            <form class="needs-validation mb-5" asp-controller="RecuperarContrasena" asp-action="Index" method="post" novalidate>
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">
                                        Correo electrónico
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Ingresa tu correo" required />
                                    <div class="invalid-feedback">Por favor ingresa un correo válido.</div>
                                    <div class="form-text">
                                        Recibirás una contraseña temporal con la que podrás ingresar y luego cambiarla desde tu perfil.
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button class="btn btn-primary" type="submit">Enviar contraseña temporal</button>
                                </div>
                            </form>

                            <div class="text-center">
                                <a asp-controller="Account" asp-action="Login">
                                    <span>Volver al inicio de sesión</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
