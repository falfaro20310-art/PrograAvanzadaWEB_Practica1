@model VitalApp_WEB.Models.ObjectiveModel
@{
    ViewData["Title"] = "Registrar objetivo";
    Layout = "_InternalLayout";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Registrar objetivo de salud</h5>
            </div>
            <div class="card-body">

                @if (TempData["MensajeObjetivo"] != null)
                {
                    <div class="alert alert-@TempData["ClaseMensajeObjetivo"]" role="alert">@TempData["MensajeObjetivo"]</div>
                }

                <form class="needs-validation" asp-controller="Objetivos" asp-action="Registrar" method="post" novalidate>

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Title" class="form-label">
                                Título del objetivo
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" type="text" class="form-control" required
                                   placeholder="Ej. Bajar la presión arterial" />
                            <div class="invalid-feedback">Por favor ingrese un título.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="IndicatorTypeId" class="form-label">
                                Indicador relacionado
                                <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IndicatorTypeId" class="form-select" required>
                                <option value="">Seleccione un indicador...</option>
                                @foreach (var tipo in Model.IndicatorTypes)
                                {
                                    <option value="@tipo.IndicatorTypeId" data-unit="@tipo.Unit">
                                        @tipo.Name (@tipo.Unit)
                                    </option>
                                }
                            </select>
                            <div class="invalid-feedback">Por favor seleccione un indicador.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InitialValue" class="form-label">Valor inicial</label>
                            <div class="input-group">
                                <input asp-for="InitialValue" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text" id="unidadInicial">—</span>
                            </div>
                            <div class="form-text">El valor actual desde donde parte el objetivo.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ObjectiveValue" class="form-label">Valor meta</label>
                            <div class="input-group">
                                <input asp-for="ObjectiveValue" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text" id="unidadMeta">—</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">
                                Fecha de inicio
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control" required
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <div class="invalid-feedback">Por favor ingrese la fecha de inicio.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LimitDate" class="form-label">Fecha límite</label>
                            <input asp-for="LimitDate" type="date" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Detalles adicionales sobre este objetivo..."></textarea>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <a asp-controller="Objetivos" asp-action="Historial" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-device-floppy me-1"></i> Guardar objetivo
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const select = document.getElementById('IndicatorTypeId');
        const unidadInicial = document.getElementById('unidadInicial');
        const unidadMeta = document.getElementById('unidadMeta');

        select.addEventListener('change', function () {
            const unit = this.options[this.selectedIndex].dataset.unit || '—';
            unidadInicial.textContent = unit;
            unidadMeta.textContent = unit;
        });

        (() => {
            'use strict';
            document.querySelectorAll('.needs-validation').forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                });
            });
        })();
    </script>
}
