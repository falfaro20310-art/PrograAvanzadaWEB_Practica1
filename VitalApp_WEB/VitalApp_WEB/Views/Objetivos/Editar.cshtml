@model VitalApp_WEB.Models.ObjectiveModel
@{
    ViewData["Title"] = "Editar objetivo";
    Layout = "_InternalLayout";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Editar objetivo de salud</h5>
            </div>
            <div class="card-body">

                @if (TempData["MensajeObjetivo"] != null)
                {
                    <div class="alert alert-@TempData["ClaseMensajeObjetivo"]" role="alert">@TempData["MensajeObjetivo"]</div>
                }

                <form class="needs-validation" asp-controller="Objetivos" asp-action="Editar" method="post" novalidate>

                    <input type="hidden" asp-for="ObjectiveId" />

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Title" class="form-label">
                                Título del objetivo
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" type="text" class="form-control" required />
                            <div class="invalid-feedback">Por favor ingrese un título.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ObjectiveValue" class="form-label">Valor meta</label>
                            <input asp-for="ObjectiveValue" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LimitDate" class="form-label">Fecha límite</label>
                            <input asp-for="LimitDate" type="date" class="form-control"
                                   value="@Model.LimitDate?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Status" class="form-label">Estado</label>
                            <select asp-for="Status" class="form-select">
                                <option value="EnProgreso">En progreso</option>
                                <option value="Completado">Completado</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <a asp-controller="Objetivos" asp-action="Historial" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-device-floppy me-1"></i> Guardar cambios
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            document.querySelectorAll('.needs-validation').forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                });
            });
        })();
    </script>
}
