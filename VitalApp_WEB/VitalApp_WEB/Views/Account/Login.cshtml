@model VitalApp_WEB.Models.UserModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_ExternalLayout";
}

<main class="d-flex flex-column justify-content-center min-vh-100 py-6">
    <section>
        <div class="container">
            <div class="row mb-6">
                <div class="col-xl-4 offset-xl-4 col-md-12 col-12">
                    <div class="text-center">
                        <div class="fs-2 fw-bold d-flex align-items-center gap-2 justify-content-center mb-6">
                            <img src="~/images/brand/logo-icon.svg" alt="VitalApp" />
                            <span>VitalApp</span>
                        </div>
                        <h1 class="mb-1">Iniciar Sesión</h1>
                        <p class="mb-0 text-secondary">Ingresa tus credenciales para continuar.</p>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-xl-5 col-lg-6 col-md-8 col-12">
                    <div class="card card-lg mb-6">
                        <div class="card-body p-6">

                            @if (TempData["MensajeExito"] != null)
                            {
                                <div class="alert alert-success" role="alert">@TempData["MensajeExito"]</div>
                            }

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-danger" role="alert">@ViewBag.Mensaje</div>
                            }

                            <form class="needs-validation mb-5" asp-controller="Account" asp-action="Login" method="post" novalidate>
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">
                                        Correo electrónico
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Ingresa tu correo" required />
                                    <div class="invalid-feedback">Por favor ingresa un correo válido.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label">
                                        Contraseña
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="password-field position-relative">
                                        <input asp-for="Password" type="password" class="form-control fakePassword" required />
                                        <span><i class="ti ti-eye-off passwordToggler"></i></span>
                                        <div class="invalid-feedback">Por favor ingresa tu contraseña.</div>
                                    </div>
                                </div>

                                <div class="mb-4 d-flex align-items-center justify-content-end">
                                    <a asp-controller="RecuperarContrasena" asp-action="Index">¿Olvidaste tu contraseña?</a>
                                </div>

                                <div class="d-grid">
                                    <button class="btn btn-primary" type="submit">Ingresar</button>
                                </div>
                            </form>

                            <div class="text-center">
                                <span>
                                    ¿No tienes una cuenta?
                                    <a asp-controller="Home" asp-action="Registro">Regístrate aquí.</a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/password.js" asp-append-version="true"></script>
}
