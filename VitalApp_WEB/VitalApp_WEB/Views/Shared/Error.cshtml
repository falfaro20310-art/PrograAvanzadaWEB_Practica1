@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_ExternalLayout";
}

<main class="d-flex flex-column justify-content-center min-vh-100 py-6">
    <section class="container">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="text-center">
                    <div>
                        <img src="~/images/404.svg" alt="Error" class="img-fluid" style="max-height: 320px;" />
                    </div>

                    <h1 class="display-4 mt-4">Ups, algo salió mal.</h1>
                    <p class="mb-6 fs-5 text-secondary">
                        No pudimos completar tu solicitud. Intenta de nuevo en unos momentos.
                    </p>

                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">Volver al inicio</a>
                    </div>

                    @if (Model.ShowRequestId)
                    {
                        <p class="text-secondary small mt-6 mb-0">
                            Si el problema persiste, comparte este código con soporte:
                            <code>@Model.RequestId</code>
                        </p>
                    }
                </div>
            </div>
        </div>

        @if (Model.ShowDetails && !string.IsNullOrEmpty(Model.StackTrace))
        {
            <div class="row justify-content-center mt-6">
                <div class="col-xl-10 col-12">
                    <div class="card card-lg">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <span class="fw-semibold text-danger">
                                <i class="ti ti-bug me-1"></i>Detalle técnico (solo visible en Development)
                            </span>
                            <button class="btn btn-outline-secondary btn-sm" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#errorDetails"
                                    aria-expanded="false" aria-controls="errorDetails">
                                Ver / ocultar
                            </button>
                        </div>
                        <div class="collapse show" id="errorDetails">
                            <div class="card-body">
                                <dl class="row mb-4">
                                    <dt class="col-sm-2">Mensaje</dt>
                                    <dd class="col-sm-10 text-danger">@Model.Message</dd>

                                    <dt class="col-sm-2">Ruta</dt>
                                    <dd class="col-sm-10"><code>@Model.Path</code></dd>
                                </dl>

                                <div class="overflow-auto" style="max-height: 420px;">
                                    <pre class="mb-0 small"><code>@Model.StackTrace</code></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
</main>
