@model VitalApp_WEB.Models.MeasureItemModel
@{
    ViewData["Title"] = "Editar medición";
    Layout = "_InternalLayout";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Editar medición — @Model.IndicatorTypeName</h5>
            </div>
            <div class="card-body">

                <form class="needs-validation" asp-controller="Mediciones" asp-action="Editar" method="post" novalidate>

                    <input type="hidden" asp-for="MeasureId" />
                    <input type="hidden" asp-for="IndicatorTypeId" />
                    <input type="hidden" asp-for="IndicatorTypeName" />
                    <input type="hidden" asp-for="Unit" />
                    <input type="hidden" asp-for="IsAbnormal" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Value" class="form-label">
                                Valor principal (@Model.Unit)
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Value" type="number" step="0.01" min="0" class="form-control" required />
                            <div class="invalid-feedback">Por favor ingrese el valor de la medición.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SecondaryValue" class="form-label">
                                Valor secundario (@Model.Unit)
                                <small class="text-muted">(ej: diastólica)</small>
                            </label>
                            <input asp-for="SecondaryValue" type="number" step="0.01" min="0" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MeasureDate" class="form-label">
                                Fecha de medición
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MeasureDate" type="datetime-local" class="form-control" required
                                   value="@Model.MeasureDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <div class="invalid-feedback">Por favor ingrese la fecha de la medición.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">Notas adicionales</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Observaciones opcionales sobre esta medición..."></textarea>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <a asp-controller="Mediciones" asp-action="Historial" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-device-floppy me-1"></i> Guardar cambios
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            document.querySelectorAll('.needs-validation').forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                });
            });
        })();
    </script>
}
