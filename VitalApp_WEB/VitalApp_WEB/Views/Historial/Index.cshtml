@model VitalApp_WEB.Models.HistorialModel
@{
    ViewData["Title"] = "Historial";
    Layout = "_InternalLayout";
}

<div class="row g-4">

    <!-- Resumen -->
    <div class="col-12">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="ti ti-activity fs-2 text-danger"></i>
                        <div>
                            <div class="fs-4 fw-bold">@Model.TotalMediciones</div>
                            <div class="text-muted small">Mediciones</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="ti ti-target-arrow fs-2 text-danger"></i>
                        <div>
                            <div class="fs-4 fw-bold">@Model.TotalAvances</div>
                            <div class="text-muted small">Avances de objetivos</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="ti ti-stethoscope fs-2 text-danger"></i>
                        <div>
                            <div class="fs-4 fw-bold">@Model.TotalCondiciones</div>
                            <div class="text-muted small">Condiciones médicas</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Filtros</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Historial" asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">

                        <div class="col-md-4">
                            <label for="EventType" class="form-label">Tipo de evento</label>
                            <select name="EventType" id="EventType" class="form-select">
                                <option value="">Todos</option>
                                <option value="Medicion" selected="@(Model.EventType == "Medicion")">Mediciones</option>
                                <option value="Avance" selected="@(Model.EventType == "Avance")">Avances de objetivos</option>
                                <option value="Condicion" selected="@(Model.EventType == "Condicion")">Condiciones médicas</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="DateFrom" class="form-label">Desde</label>
                            <input type="date" name="DateFrom" id="DateFrom" class="form-control"
                                   value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-3">
                            <label for="DateTo" class="form-label">Hasta</label>
                            <input type="date" name="DateTo" id="DateTo" class="form-control"
                                   value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-danger w-100">Filtrar</button>
                            <a asp-controller="Historial" asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Linea de tiempo -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Línea de tiempo</h5>
            </div>

            @if (!Model.Events.Any())
            {
                <div class="card-body text-center text-muted py-5">
                    <i class="ti ti-history fs-1 d-block mb-2"></i>
                    No se encontraron eventos con los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="card-body" style="max-height:80vh;overflow-y:auto;">
                    <ul class="list-unstyled mb-0">
                        @foreach (var e in Model.Events)
                        {
                            var (icon, colorClass, badgeLabel) = e.EventType switch
                            {
                                "Medicion" => ("ti-activity", e.IsAbnormal ? "bg-danger" : "bg-success", "Medición"),
                                "Avance" => ("ti-target-arrow", "bg-primary", "Avance de objetivo"),
                                "Condicion" => ("ti-stethoscope", "bg-warning", "Condición médica"),
                                _ => ("ti-circle", "bg-secondary", e.EventType)
                            };

                            <li class="d-flex gap-3 pb-4 position-relative">
                                <div class="d-flex flex-column align-items-center">
                                    <span class="d-flex align-items-center justify-content-center rounded-circle text-white @colorClass"
                                          style="width:2.25rem;height:2.25rem;min-width:2.25rem;">
                                        <i class="ti @icon"></i>
                                    </span>
                                    <span class="flex-grow-1 border-start" style="border-color:var(--ds-border-color) !important;"></span>
                                </div>
                                <div class="flex-grow-1 pb-1">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <span class="badge @colorClass mb-1">@badgeLabel</span>
                                            <div class="fw-semibold">@e.Title</div>
                                            <div class="text-muted">@e.Detail</div>
                                        </div>
                                        <div class="text-muted small text-nowrap">@e.EventDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

</div>
