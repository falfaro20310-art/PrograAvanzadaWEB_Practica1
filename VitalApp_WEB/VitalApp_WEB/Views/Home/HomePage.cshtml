@model List<VitalApp_WEB.Models.DashboardModel>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_InternalLayout";

    var userName = Context.Session.GetString("Name") ?? "Usuario";

    // Indicadores fuera de rango normal (se usan para Alertas y Recomendaciones)
    var alertas = Model?.Where(m => m.IsAbnormal == true).ToList() ?? new List<VitalApp_WEB.Models.DashboardModel>();

    // Helper local: icono + color de fondo/texto segun el nombre del indicador.
    // Si llega un indicador nuevo que no este mapeado, cae en el "default".
    (string icon, string color) GetIndicatorStyle(string name)
    {
        return name?.Trim().ToLower() switch
        {
            "peso" => ("ti-scale", "danger"),
            "presión arterial" or "presion arterial" => ("ti-heart-rate-monitor", "warning"),
            "glucosa" => ("ti-droplet", "info"),
            "frecuencia cardíaca" or "frecuencia cardiaca" => ("ti-activity", "danger"),
            "estado de ánimo" or "estado de animo" => ("ti-mood-happy", "success"),
            "sueño" or "sueno" or "horas de sueño" => ("ti-moon", "primary"),
            _ => ("ti-chart-line", "secondary")
        };
    }

    // Helper local: calcula el % de la barra de progreso segun el rango normal.
    // Si no hay valor o el rango es invalido, retorna 0.
    int GetProgressPercent(VitalApp_WEB.Models.DashboardModel m)
    {
        if (m.LastValue == null || m.MaxNormalValue <= m.MinNormalValue)
        {
            return 0;
        }

        var rango = m.MaxNormalValue - m.MinNormalValue;
        var posicion = m.LastValue.Value - m.MinNormalValue;
        var porcentaje = (posicion / rango) * 100;

        if (porcentaje < 0) porcentaje = 0;
        if (porcentaje > 100) porcentaje = 100;

        return (int)porcentaje;
    }
}

<!-- Bienvenida + Recomendaciones dinamicas -->
<div class="row mb-4 g-4">
    <div class="col-xl-8 col-lg-6">
        <div class="p-5 rounded-3 text-white hero-banner">
            <h1 class="fs-3">Hola, @userName</h1>
            <p class="mb-0">Bienvenido a VitalApp. Registra tus métricas diarias,</p>
            <p>visualiza tu progreso y recibe alertas personalizadas.</p>
            <a asp-controller="Mediciones" asp-action="Registrar" class="btn btn-light text-danger fw-semibold">Registrar métricas</a>
        </div>
    </div>
    <div class="col-xl-4 col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">Recomendaciones</h5>
                @if (alertas.Any())
                {
                    <div class="swiper" id="swiper-1">
                        <div class="swiper-wrapper">
                            @foreach (var item in alertas)
                            {
                                <div class="swiper-slide">
                                    <h6>@item.Name fuera de rango</h6>
                                    <p class="text-muted small">
                                        Último valor: @item.LastValue @item.Unit
                                        (rango normal: @item.MinNormalValue - @item.MaxNormalValue @item.Unit).
                                    </p>
                                    <a asp-controller="Mediciones" asp-action="Historial" asp-route-indicatorTypeId="@item.IndicatorTypeId" class="btn btn-outline-danger btn-sm">Ver historial</a>
                                </div>
                            }
                        </div>
                        <div class="swiper-pagination mt-2"></div>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="ti ti-mood-happy fs-1 text-success"></i>
                        <p class="text-muted small mb-0">Todos tus indicadores están dentro del rango normal. ¡Sigue así!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas de métricas de salud -->
<div class="row row-cols-1 row-cols-md-3 mb-4 g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            var (icon, color) = GetIndicatorStyle(item.Name);
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-@color bg-opacity-10 p-2 text-@color">
                                <i class="ti @icon fs-5"></i>
                            </div>
                            <span class="fw-semibold">@item.Name</span>
                        </div>

                        @if (item.LastValue == null)
                        {
                            <div class="text-center py-2">
                                <span class="text-muted">Sin datos disponibles</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fs-3 fw-bold">
                                    @item.LastValue @item.Unit
                                    @if (item.SecondaryValue != null)
                                    {
                                        <text>/ @item.SecondaryValue</text>
                                    }
                                </span>
                                @if (item.IsAbnormal == true)
                                {
                                    <span class="text-danger small">⚠ Fuera de rango</span>
                                }
                                else
                                {
                                    <span class="text-success small">✓ Normal</span>
                                }
                            </div>
                            <div class="progress" style="height:6px">
                                <div class="progress-bar bg-@color" style="width:@(GetProgressPercent(item))%"></div>
                            </div>
                            <small class="text-muted">
                                Último registro: @item.LastMeasureDate?.ToString("dd MMM, yyyy")
                            </small>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info mb-0">
                Aún no tienes indicadores configurados. Comienza registrando tu primera métrica.
            </div>
        </div>
    }
</div>

<!-- Resumen Semanal / Mensual + Alertas -->
<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Resumen Semanal y Mensual</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Indicador</th>
                            <th>Prom. semanal</th>
                            <th>Mín. / Máx. semanal</th>
                            <th>Prom. mensual</th>
                            <th>Mín. / Máx. mensual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    @if (item.WeeklyAverage == null)
                                    {
                                        <td colspan="2" class="text-muted">Sin datos disponibles</td>
                                    }
                                    else
                                    {
                                        <td>@item.WeeklyAverage @item.Unit</td>
                                        <td>@item.WeeklyMinimum / @item.WeeklyMaximum @item.Unit</td>
                                    }
                                    @if (item.MonthlyAverage == null)
                                    {
                                        <td colspan="2" class="text-muted">Sin datos disponibles</td>
                                    }
                                    else
                                    {
                                        <td>@item.MonthlyAverage @item.Unit</td>
                                        <td>@item.MonthlyMinimum / @item.MonthlyMaximum @item.Unit</td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No hay datos para mostrar.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Alertas Activas (@alertas.Count)</h5>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                @if (alertas.Any())
                {
                    foreach (var item in alertas)
                    {
                        var (icon, _) = GetIndicatorStyle(item.Name);
                        <div class="alert alert-danger d-flex gap-3 mb-0">
                            <i class="ti @icon fs-4"></i>
                            <div>
                                <div class="fw-semibold">@item.Name fuera de rango</div>
                                <small>
                                    Último valor: @item.LastValue @item.Unit el
                                    @item.LastMeasureDate?.ToString("dd MMM, yyyy").
                                </small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-success d-flex gap-3 mb-0">
                        <i class="ti ti-circle-check fs-4"></i>
                        <div>
                            <div class="fw-semibold">Sin alertas activas</div>
                            <small>Todos tus indicadores están dentro del rango normal.</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/homePage.js" asp-append-version="true"></script>
}
