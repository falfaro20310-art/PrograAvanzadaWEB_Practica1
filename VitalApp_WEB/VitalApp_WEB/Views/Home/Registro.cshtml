@model VitalApp_WEB.Models.UserModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_ExternalLayout";
}

<main class="d-flex flex-column justify-content-center min-vh-100 py-6">
    <section>
        <div class="container">
            <div class="row mb-6">
                <div class="col-xl-4 offset-xl-4 col-md-12 col-12">
                    <div class="text-center">
                        <div class="fs-2 fw-bold d-flex align-items-center gap-2 justify-content-center mb-6">
                            <img src="~/images/brand/logo-icon.svg" alt="VitalApp" />
                            <span>VitalApp</span>
                        </div>
                        <h1 class="mb-1">Crear Cuenta</h1>
                        <p class="mb-0 text-secondary">Regístrate y empieza a cuidar tu salud.</p>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-xl-5 col-lg-6 col-md-8 col-12">
                    <div class="card card-lg mb-6">
                        <div class="card-body p-6">

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-danger" role="alert">@ViewBag.Mensaje</div>
                            }

                            <form class="needs-validation mb-5" asp-controller="Home" asp-action="Registro" method="post" novalidate>
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">
                                        Nombre
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" type="text" class="form-control" placeholder="Ingresa tu nombre" required />
                                    <div class="invalid-feedback">Por favor ingresa tu nombre.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="FirstName" class="form-label">
                                        Primer apellido
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FirstName" type="text" class="form-control" placeholder="Ingresa tu primer apellido" required />
                                    <div class="invalid-feedback">Por favor ingresa tu primer apellido.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="LastName" class="form-label">
                                        Segundo apellido
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="LastName" type="text" class="form-control" placeholder="Ingresa tu segundo apellido" required />
                                    <div class="invalid-feedback">Por favor ingresa tu segundo apellido.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="IdCard" class="form-label">
                                        Cédula
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="IdCard" type="text" class="form-control" placeholder="Ingresa tu cédula" required />
                                    <div class="invalid-feedback">Por favor ingresa tu cédula.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">
                                        Correo electrónico
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Ingresa tu correo" required />
                                    <div class="invalid-feedback">Por favor ingresa un correo válido.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label">
                                        Contraseña
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="password-field position-relative">
                                        <input asp-for="Password" type="password" class="form-control fakePassword" id="registerPassword"
                                               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$" required />
                                        <span><i class="ti ti-eye-off passwordToggler"></i></span>
                                        <div class="invalid-feedback">Mínimo 8 caracteres, con mayúscula, minúscula, número y carácter especial.</div>
                                    </div>
                                    <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y carácter especial.</div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ConfirmPassword" class="form-label">
                                        Confirmar contraseña
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="password-field position-relative">
                                        <input asp-for="ConfirmPassword" type="password" class="form-control fakePassword" id="registerConfirmPassword" required />
                                        <span><i class="ti ti-eye-off passwordToggler"></i></span>
                                        <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button class="btn btn-primary" type="submit">Crear cuenta</button>
                                </div>
                            </form>

                            <div class="text-center">
                                <span>
                                    ¿Ya tienes una cuenta?
                                    <a asp-controller="Account" asp-action="Login">Inicia sesión aquí.</a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/password.js" asp-append-version="true"></script>
    <script src="~/js/registro.js" asp-append-version="true"></script>
}
