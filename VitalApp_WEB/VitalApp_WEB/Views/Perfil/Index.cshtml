@model VitalApp_WEB.Models.ProfileModel
@{
    ViewData["Title"] = "Perfil";
    Layout = "_InternalLayout";
}

<div class="row g-4">

    <!-- ===== Datos personales ===== -->
    <div class="col-xl-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">👤 Datos personales</h5>
            </div>
            <div class="card-body">

                @if (TempData["MensajePerfil"] != null)
                {
                    <div class="alert alert-@TempData["ClaseMensajePerfil"]" role="alert">@TempData["MensajePerfil"]</div>
                }

                <form class="needs-validation" asp-controller="Perfil" asp-action="ActualizarPerfil" method="post" novalidate>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Name" class="form-label">
                                Nombre
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" type="text" class="form-control" required />
                            <div class="invalid-feedback">Por favor ingresa tu nombre.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FirstName" class="form-label">
                                Primer apellido
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" type="text" class="form-control" required />
                            <div class="invalid-feedback">Por favor ingresa tu primer apellido.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LastName" class="form-label">
                                Segundo apellido
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" type="text" class="form-control" required />
                            <div class="invalid-feedback">Por favor ingresa tu segundo apellido.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdCard" class="form-label">Cédula</label>
                            <input asp-for="IdCard" type="text" class="form-control" readonly disabled />
                            <div class="form-text">La cédula no se puede modificar.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Email" type="email" class="form-control" readonly disabled />
                            <div class="form-text">El correo es tu usuario de acceso.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BirthDate" class="form-label">Fecha de nacimiento</label>
                            <input asp-for="BirthDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
                            <div class="form-text">
                                @if (Model.Age != null)
                                {
                                    <span>Edad actual: <strong>@Model.Age años</strong></span>
                                }
                                else
                                {
                                    <span>Ingresa tu fecha de nacimiento para calcular tu edad.</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label">Sexo</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Seleccione...</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Height" class="form-label">Altura (cm)</label>
                            <input asp-for="Height" type="number" step="0.01" min="0" max="999.99" class="form-control" placeholder="Ej. 170.00" />
                            <div class="invalid-feedback">Ingresa una altura válida.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Weight" class="form-label">Peso (kg)</label>
                            <input asp-for="Weight" type="number" step="0.01" min="0" max="999.99" class="form-control" placeholder="Ej. 68.50" />
                            <div class="invalid-feedback">Ingresa un peso válido.</div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button class="btn btn-primary" type="submit">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ===== Condiciones medicas ===== -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">🩺 Condiciones médicas</h5>
            </div>
            <div class="card-body">

                @if (TempData["MensajeCondicion"] != null)
                {
                    <div class="alert alert-@TempData["ClaseMensajeCondicion"]" role="alert">@TempData["MensajeCondicion"]</div>
                }

                @if (Model.MedicalConditions.Any())
                {
                    <div class="table-responsive mb-4">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Condición</th>
                                    <th>Descripción</th>
                                    <th>Diagnóstico</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var condition in Model.MedicalConditions)
                                {
                                    <tr>
                                        <td>@condition.Name</td>
                                        <td>@condition.Description</td>
                                        <td>@condition.DiagnosticDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">
                                            <form asp-controller="Perfil" asp-action="EliminarCondicion" method="post" class="d-inline">
                                                <input type="hidden" name="MedicalConditionId" value="@condition.MedicalConditionId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Aún no has registrado condiciones médicas.</p>
                }

                <hr />

                <h6 class="mb-3">Agregar condición</h6>
                <form class="needs-validation" asp-controller="Perfil" asp-action="AgregarCondicion" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="conditionName" class="form-label">
                                Condición
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="conditionName" name="Name" class="form-control" placeholder="Ej. Hipertensión" required />
                            <div class="invalid-feedback">Ingresa el nombre de la condición.</div>
                        </div>
                        <div class="col-md-5">
                            <label for="conditionDescription" class="form-label">
                                Descripción
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="conditionDescription" name="Description" class="form-control" placeholder="Ej. Controlada con medicamento" required />
                            <div class="invalid-feedback">Ingresa una descripción.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="conditionDate" class="form-label">
                                Fecha diagnóstico
                                <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="conditionDate" name="DiagnosticDate" class="form-control" required />
                            <div class="invalid-feedback">Ingresa la fecha.</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="ti ti-plus me-1"></i>Agregar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ===== Cambiar contrasena ===== -->
    <div class="col-xl-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">🔒 Cambiar contraseña</h5>
            </div>
            <div class="card-body">

                @if (TempData["MensajeSeguridad"] != null)
                {
                    <div class="alert alert-@TempData["ClaseMensajeSeguridad"]" role="alert">@TempData["MensajeSeguridad"]</div>
                }

                <form class="needs-validation" asp-controller="Perfil" asp-action="CambiarContrasena" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            Nueva contraseña
                            <span class="text-danger">*</span>
                        </label>
                        <div class="password-field position-relative">
                            <input asp-for="Password" type="password" class="form-control fakePassword" id="profilePassword"
                                   pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$" required />
                            <span><i class="ti ti-eye-off passwordToggler"></i></span>
                            <div class="invalid-feedback">Mínimo 8 caracteres, con mayúscula, minúscula, número y carácter especial.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirmar contraseña
                            <span class="text-danger">*</span>
                        </label>
                        <div class="password-field position-relative">
                            <input asp-for="ConfirmPassword" type="password" class="form-control fakePassword" id="profileConfirmPassword" required />
                            <span><i class="ti ti-eye-off passwordToggler"></i></span>
                            <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary" type="submit">Actualizar contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/password.js" asp-append-version="true"></script>
    <script src="~/js/perfil.js" asp-append-version="true"></script>
}
